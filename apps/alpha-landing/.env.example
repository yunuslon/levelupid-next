# Alpha Landing Environment Variables

# API Base URL
ALPHA_API_URL=https://api.levelupid.com
# For local development with backend:
# ALPHA_API_URL=http://localhost:8000

# Cloudflare Access (for /register and /landing/newsletter endpoints)
# Get these from your Cloudflare dashboard > Access > Service Auth
CF_ACCESS_CLIENT_ID=your_client_id_here
CF_ACCESS_CLIENT_SECRET=your_client_secret_here

# Site URL (for metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
